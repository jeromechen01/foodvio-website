"// ai-chat —— 主站 AI 客服（公开访问，无需登录）。\n// RAG：从 _shared/kb.json 关键词检索相关页面 → 作为资料喂给 DeepSeek → 生成回答。\n// secrets: DEEPSEEK_API_KEY（必需），DEEPSEEK_MODEL（可选，默认 deepseek-chat）。\n// 原则：只依据站内资料回答、不编造；华仔爸爸品牌商品购买引导到商城；遵守文案禁词。\n// 不改数据库/其它函数。\n\nimport kbData from '../_shared/kb.json' with { type: 'json' };\n\ninterface KbPage {\n  url: string;\n  title: string;\n  description: string;\n  headings: string[];\n  text: string;\n}\nconst kb = kbData as KbPage[];\n\nconst DEEPSEEK_BASE = 'https://api.deepseek.com';\n\nconst cors = {\n  'Access-Control-Allow-Origin': '*',\n  'Access-Control-Allow-Headers': 'authorization, x-client-info, apikey, content-type',\n  'Access-Control-Allow-Methods': 'POST, OPTIONS',\n};\nconst json = (b: unknown, s = 200) =>\n  new Response(JSON.stringify(b), { status: s, headers: { ...cors, 'Content-Type': 'application/json' } });\n\nfunction terms(q: string): string[] {\n  const s = q.toLowerCase().trim();\n  const set = new Set<string>();\n  if (s) set.add(s);\n  for (const w of s.split(/[^a-z0-9]+/i)) if (w.length >= 2) set.add(w);\n  const cjk = s.replace(/[^一-龥]/g, '');\n  if (cjk.length === 1) set.add(cjk);\n  for (let i = 0; i < cjk.length - 1; i++) set.add(cjk.slice(i, i + 2));\n  return [...set].filter(Boolean);\n}\nfunction countOcc(hay: string, needle: string): number {\n  if (!needle) return 0;\n  const h = hay.toLowerCase();\n  let n = 0;\n  let i = 0;\n  while ((i = h.indexOf(needle, i)) !== -1) {\n    n++;\n    i += needle.length;\n  }\n  return n;\n}\nfunction retrieve(query: string, topN: number): KbPage[] {\n  const ts = terms(query);\n  const ql = query.toLowerCase().trim();\n  return kb\n    .map((p) => {\n      const head = (p.headings || []).join(' ');\n      let score = 0;\n      for (const t of ts) {\n        score += countOcc(p.title || '', t) * 5;\n        score += countOcc(p.description || '', t) * 3;\n        score += countOcc(head, t) * 3;\n        score += countOcc(p.text || '', t) * 1;\n      }\n      if (ql && (p.text || '').toLowerCase().includes(ql)) score += 4;\n      return { p, score };\n    })\n    .filter((x) => x.score > 0)\n    .sort((a, b) => b.score - a.score)\n    .slice(0, topN)\n    .map((x) => x.p);\n}\n\n// 文案禁词：指示模型避免使用（涉及时换表述）\nconst BANNED = ['预制菜', '半成品', '西餐发源地', '江西辣椒', '30天打样', '商超自有品牌', '麦肯薯角', '麻辣牛肉', '即食鸡丝'];\n\nconst SYSTEM = [\n  '你是 Foodvio（花花食界）官网的智能客服助手。',\n  '只依据下方【网站资料】回答用户问题；资料中没有的信息，请如实说明暂未查到，并建议用户留下联系方式或通过官网联系页咨询，不要编造价格、库存、参数等任何未在资料中出现的数据。',\n  '如用户想购买「华仔爸爸 ChinnPaPa」品牌商品，请引导前往华仔爸爸官方商城下单（本官网为 B2B 展示站，不直接下单）。',\n  '回答简洁、专业、用中文。',\n  `请勿使用以下词语（若涉及请改用中性表述）：${BANNED.join('、')}。`,\n].join('\\n');\n\ninterface ChatMsg {\n  role: 'user' | 'assistant' | 'system';\n  content: string;\n}\n\nDeno.serve(async (req: Request): Promise<Response> => {\n  if (req.method === 'OPTIONS') return new Response(null, { status: 204, headers: cors });\n  if (req.method !== 'POST') return json({ error: 'METHOD_NOT_ALLOWED' }, 405);\n\n  const DEEPSEEK_API_KEY = Deno.env.get('DEEPSEEK_API_KEY');\n  const MODEL = Deno.env.get('DEEPSEEK_MODEL') || 'deepseek-chat';\n  if (!DEEPSEEK_API_KEY) {\n    console.error('[ai-chat] 缺少 DEEPSEEK_API_KEY');\n    return json({ error: 'AI_NOT_CONFIGURED' }, 503);\n  }\n\n  let messages: ChatMsg[] = [];\n  try {\n    const body = await req.json();\n    messages = Array.isArray(body?.messages) ? body.messages : [];\n  } catch {\n    return json({ error: 'BAD_REQUEST' }, 400);\n  }\n  const history = messages\n    .filter((m) => m && (m.role === 'user' || m.role === 'assistant') && typeof m.content === 'string')\n    .slice(-8);\n  const lastUser = [...history].reverse().find((m) => m.role === 'user')?.content ?? '';\n  if (!lastUser.trim()) return json({ error: 'EMPTY_QUERY' }, 400);\n\n  // 检索相关页面，拼装资料上下文\n  const pages = retrieve(lastUser, 5);\n  const context = pages\n    .map((p, i) => `【资料${i + 1}】${p.title}（${p.url}）\\n${p.text}`)\n    .join('\\n\\n');\n  const sources = pages.map((p) => ({ url: p.url, title: p.title }));\n\n  const payloadMessages: ChatMsg[] = [\n    { role: 'system', content: `${SYSTEM}\\n\\n【网站资料】\\n${context || '（未检索到相关资料）'}` },\n    ...history,\n  ];\n\n  try {\n    const resp = await fetch(`${DEEPSEEK_BASE}/chat/completions`, {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${DEEPSEEK_API_KEY}` },\n      body: JSON.stringify({ model: MODEL, temperature: 0.3, messages: payloadMessages }),\n    });\n    if (!resp.ok) {\n      const detail = await resp.text();\n      console.error('[ai-chat] DeepSeek 调用失败', resp.status, detail.slice(0, 300));\n      return json({ error: 'DEEPSEEK_HTTP_' + resp.status, detail }, 502);\n    }\n    const data = await resp.json();\n    const reply = data?.choices?.[0]?.message?.content?.trim() ?? '';\n    if (!reply) return json({ error: 'EMPTY_REPLY' }, 502);\n    return json({ reply, sources });\n  } catch (e) {\n    console.error('[ai-chat] 异常', e);\n    return json({ error: String(e) }, 500);\n  }\n});\n"